<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- Подключаем наш SQL-файл с начальной схемой -->
    <include file="001-initial-schema.sql" relativeToChangelogFile="true"/>

    <!-- Добавление поля compact_schedule в таблицу educator -->
    <include file="002-add-educator-compact-schedule.sql" relativeToChangelogFile="true"/>

    <!-- CQRS Query Side: Создание таблицы schedule_view -->
    <include file="003-create-schedule-view.sql" relativeToChangelogFile="true"/>

    <!-- CQRS Command Side: Создание таблиц schedule_session и lesson_placement -->
    <include file="004-create-command-side.sql" relativeToChangelogFile="true"/>

    <!-- CQRS Command Side: Исправление constraints для мульти-групповой поддержки -->
    <include file="005-fix-constraints.sql" relativeToChangelogFile="true"/>

    <!-- CQRS Query Side: Исправление constraint schedule_view для мульти-групповой поддержки -->
    <include file="006-fix-schedule-view-constraint.sql" relativeToChangelogFile="true"/>

    <!-- CQRS Query Side: Ссылка на CurriculumSlot в schedule_view (для сцепок занятий) -->
    <include file="007-add-curriculum-slot-to-view.sql" relativeToChangelogFile="true"/>

    <!-- Краткие описания (COMMENT ON TABLE) для таблиц начальной схемы -->
    <include file="008-add-table-comments.sql" relativeToChangelogFile="true"/>

    <!-- Краткие описания (COMMENT ON COLUMN) для ключевых полей -->
    <include file="009-add-column-comments.sql" relativeToChangelogFile="true"/>

    <!-- Порядковый семестр на discipline_course + новый уникальный ключ -->
    <include file="010-add-discipline-course-semester.sql" relativeToChangelogFile="true"/>

    <!-- UNIQUE(course, position) на curriculum_slot → DEFERRABLE: чинит вставку слота в середину -->
    <include file="011-curriculum-slot-position-deferrable.sql" relativeToChangelogFile="true"/>

    <!-- Пер-парные ограничения: nullable time_slot в трёх таблицах ограничений -->
    <include file="012-add-constraint-time-slot.sql" relativeToChangelogFile="true"/>

    <!-- Фича 2 (пины): флаг locked + source на lesson_placement -->
    <include file="013-add-placement-lock-source.sql" relativeToChangelogFile="true"/>

    <!-- Фича 2 (пины): проекция locked + source в read-модель schedule_view -->
    <include file="014-add-view-lock-source.sql" relativeToChangelogFile="true"/>

    <!-- Фича 2 (Путь 2): привязка сессии расписания к учебному периоду -->
    <include file="015-add-session-study-period.sql" relativeToChangelogFile="true"/>

    <!-- Совместные занятия: UNIQUE schedule_view → (placement_id, study_stream_id, educator_id),
         чтобы занятие с несколькими преподавателями проецировалось по строке на каждого -->
    <include file="016-widen-schedule-view-educator-unique.sql" relativeToChangelogFile="true"/>

    <!-- Read-модель производна от write-стороны: FK schedule_view → lesson_placement
         (ON DELETE CASCADE), чтобы каскады БД не оставляли строк-призраков -->
    <include file="017-schedule-view-placement-fk.sql" relativeToChangelogFile="true"/>

    <!-- Оргструктура: подразделения (факультеты, кафедры, отделы) самоссылочным деревом
         + принадлежность преподавателей и групп -->
    <include file="018-create-org-unit.sql" relativeToChangelogFile="true"/>

    <!-- Год набора группы: отличает одноимённые группы разных наборов -->
    <include file="019-add-group-enrollment-year.sql" relativeToChangelogFile="true"/>

    <!-- Регалии преподавателя: специальное звание (+ род службы), учёная степень (уровень +
         отрасль науки) и учёное звание; справочники ведёт пользователь -->
    <include file="020-create-educator-credentials.sql" relativeToChangelogFile="true"/>

    <!-- Виды занятий: справочник kind_of_study заполнялся только демо-данными из
         .gitignore'нутого db/values/, и на чистой БД вставка занятия падала по FK -->
    <include file="021-seed-kind-of-study.sql" relativeToChangelogFile="true"/>

    <!-- Виды ограничений — из Java-enum в пользовательский справочник: код по ним не ветвится,
         значит перечень принадлежит пользователю, а не релизу -->
    <include file="022-create-kind-of-constraint.sql" relativeToChangelogFile="true"/>

    <!-- Экзаменационная сессия: норма плана «где сдаётся аттестация» (curriculum_slot) и режим
         интервала «что он впускает» (kind_of_constraint) — два разных вопроса, две колонки -->
    <include file="023-assessment-window.sql" relativeToChangelogFile="true"/>

    <!-- Сокращение степени пишется слитно и без точек («ктн»): комментарии 020 описывали прежнее
         правило, а править применённый чейнджлог нельзя — контрольная сумма -->
    <include file="024-degree-abbreviation-comments.sql" relativeToChangelogFile="true"/>

</databaseChangeLog>